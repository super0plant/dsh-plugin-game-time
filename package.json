{
  "name": "dsh-plugin-game-time",
  "version": "0.11.4",
  "type": "module",
  "description": "Local per-game play-time tracking for Windows, as a DeepSeek Harness (DSH) plugin or a standalone web app.",
  "author": "super0plant <super0plant@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/super0plant/dsh-plugin-game-time.git"
  },
  "homepage": "https://github.com/super0plant/dsh-plugin-game-time#readme",
  "bugs": {
    "url": "https://github.com/super0plant/dsh-plugin-game-time/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "game-time",
    "playtime",
    "playtime-tracker",
    "game-tracker",
    "local-first",
    "windows"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon.ico",
    "standalone",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node tests/render-check.mjs && node tests/host-check.mjs && node tests/exit-check.mjs && node tests/restore-check.mjs && node tests/standalone-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
