{
  "name": "dsh-plugin-game-time",
  "version": "0.16.2",
  "type": "module",
  "description": "Per-game playtime tracker and game timer for DeepSeek Harness (DSH) on Windows: game stats and playtime stats by day, week, month and all time, stored locally.",
  "author": "super0plant <super0plant@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/super0plant/dsh-plugin-game-time.git"
  },
  "homepage": "https://github.com/super0plant/dsh-plugin-game-time#readme",
  "bugs": {
    "url": "https://github.com/super0plant/dsh-plugin-game-time/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "game-time",
    "playtime",
    "playtime-tracker",
    "playtime-stats",
    "game-stats",
    "game-timer",
    "game-tracker",
    "local-first",
    "windows",
    "游戏时长",
    "游玩时长",
    "游戏统计",
    "时长统计",
    "游戏计时"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./index.js",
  "os": [
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon.ico",
    "screenshots.json",
    "docs/screenshots",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node tests/render-check.mjs && node tests/host-check.mjs && node tests/exit-check.mjs && node tests/restore-check.mjs",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
